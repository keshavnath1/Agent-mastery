{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence Bundle",
  "type": "object",
  "required": [
    "module_id",
    "gate",
    "status",
    "artifacts",
    "provenance"
  ],
  "properties": {
    "module_id": {
      "type": "string"
    },
    "gate": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "CANDIDATE"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "provenance": {
      "type": "object"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
