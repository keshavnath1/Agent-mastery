{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/learning_review.schema.json",
  "title": "Independent Skill Proposal Review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_status", "review_id", "proposal_id", "author_identity", "reviewer", "reviewed_at", "candidate_commit", "verdict", "github_review", "reruns", "findings", "privacy_review"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_status": {"enum": ["TEMPLATE", "RECORDED"]},
    "review_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{2,127}$"},
    "proposal_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{2,127}$"},
    "author_identity": {"type": "string", "minLength": 2, "maxLength": 200},
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "role"],
      "properties": {
        "identity": {"type": "string", "minLength": 2, "maxLength": 200},
        "role": {"enum": ["checker", "human_approver"]}
      }
    },
    "reviewed_at": {"type": "string", "format": "date-time"},
    "candidate_commit": {"$ref": "#/$defs/sha1"},
    "verdict": {"enum": ["ACCEPT", "REJECT", "BLOCKED"]},
    "github_review": {"oneOf": [{"$ref": "#/$defs/github_review"}, {"type": "null"}]},
    "reruns": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/run_result"}
    },
    "findings": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
    "privacy_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contains_chain_of_thought", "contains_secrets", "contains_raw_business_data"],
      "properties": {
        "contains_chain_of_thought": {"const": false},
        "contains_secrets": {"const": false},
        "contains_raw_business_data": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sha1": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "run_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "command", "exit_code", "result", "result_path", "result_sha256", "evaluator_sha256"],
      "properties": {
        "kind": {"enum": ["architecture", "normal", "pressure"]},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
        "exit_code": {"type": "integer"},
        "result": {"enum": ["PASS", "FAIL", "BLOCKED"]},
        "result_path": {"type": "string", "minLength": 1, "maxLength": 500},
        "result_sha256": {"$ref": "#/$defs/sha256"},
        "evaluator_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "github_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "pull_request", "review_id", "reviewer_login", "reviewed_commit"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "pull_request": {"type": "integer", "minimum": 1},
        "review_id": {"type": "integer", "minimum": 1},
        "reviewer_login": {"type": "string", "minLength": 1, "maxLength": 100},
        "reviewed_commit": {"$ref": "#/$defs/sha1"}
      }
    }
  }
}
