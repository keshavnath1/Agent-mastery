{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Semantic IR",
  "type": "object",
  "required": [
    "module_id",
    "version",
    "inputs",
    "transformations",
    "outputs",
    "unresolved"
  ],
  "properties": {
    "module_id": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "transformations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
