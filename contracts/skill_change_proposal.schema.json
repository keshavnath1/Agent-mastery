{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/skill_change_proposal.schema.json",
  "title": "Governed Skill Change Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_status",
    "proposal_id",
    "status",
    "created_at",
    "author",
    "target_skill",
    "target_skill_path",
    "source_patterns",
    "hypothesis",
    "change_scope",
    "baseline_commit",
    "candidate_commit",
    "patch",
    "protected_contract_changes",
    "frozen_evaluators",
    "validation",
    "independent_review",
    "proof_boundary",
    "rollback",
    "human_promotion"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_status": {"enum": ["TEMPLATE", "RECORDED"]},
    "proposal_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{2,127}$"},
    "status": {"enum": ["TEMPLATE", "DRAFT", "VALIDATING", "CANDIDATE_FOR_PROMOTION", "PROMOTED", "REJECTED", "ROLLED_BACK"]},
    "created_at": {"type": "string", "format": "date-time"},
    "author": {"$ref": "#/$defs/actor"},
    "target_skill": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "target_skill_path": {"type": "string", "pattern": "^\\.github/skills/[a-z0-9-]+/SKILL\\.md$"},
    "source_patterns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/named_ref"}
    },
    "hypothesis": {"type": "string", "minLength": 10, "maxLength": 2000},
    "change_scope": {"type": "string", "minLength": 10, "maxLength": 2000},
    "baseline_commit": {"$ref": "#/$defs/sha1"},
    "candidate_commit": {"oneOf": [{"$ref": "#/$defs/sha1"}, {"type": "null"}]},
    "patch": {"$ref": "#/$defs/file_ref"},
    "protected_contract_changes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prd", "spec", "adr", "tieout_contract", "oracle", "expected_outputs", "tolerances", "evaluators", "approval_gates"],
      "properties": {
        "prd": {"const": false},
        "spec": {"const": false},
        "adr": {"const": false},
        "tieout_contract": {"const": false},
        "oracle": {"const": false},
        "expected_outputs": {"const": false},
        "tolerances": {"const": false},
        "evaluators": {"const": false},
        "approval_gates": {"const": false}
      }
    },
    "frozen_evaluators": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "sha256"],
        "properties": {
          "kind": {"enum": ["architecture", "normal", "pressure"]},
          "path": {"type": "string", "minLength": 1, "maxLength": 500},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runs", "governance_regressions", "target_improved_or_defect_resolved", "result"],
      "properties": {
        "runs": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"$ref": "#/$defs/run_result"}
        },
        "governance_regressions": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 500}},
        "target_improved_or_defect_resolved": {"type": "boolean"},
        "result": {"enum": ["NOT_RUN", "PASS", "FAIL"]}
      }
    },
    "independent_review": {
      "oneOf": [{"$ref": "#/$defs/named_ref"}, {"type": "null"}]
    },
    "proof_boundary": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "rejected_changes_preserved_in_history"],
      "properties": {
        "strategy": {"type": "string", "minLength": 5, "maxLength": 1000},
        "rejected_changes_preserved_in_history": {"const": true}
      }
    },
    "human_promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "run_state_path", "run_state_sha256", "promotion_commit", "github_review"],
      "properties": {
        "decision": {"enum": ["PENDING", "APPROVED", "REJECTED"]},
        "run_state_path": {"type": ["string", "null"], "maxLength": 500},
        "run_state_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "promotion_commit": {"oneOf": [{"$ref": "#/$defs/sha1"}, {"type": "null"}]},
        "github_review": {"oneOf": [{"$ref": "#/$defs/github_review"}, {"type": "null"}]}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sha1": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "role"],
      "properties": {
        "identity": {"type": "string", "minLength": 2, "maxLength": 200},
        "role": {"enum": ["analyst", "maker"]}
      }
    },
    "file_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 500},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "named_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 3, "maxLength": 128},
        "path": {"type": "string", "minLength": 1, "maxLength": 500},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "run_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "command", "exit_code", "result", "result_path", "result_sha256", "evaluator_sha256"],
      "properties": {
        "kind": {"enum": ["architecture", "normal", "pressure"]},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
        "exit_code": {"type": "integer"},
        "result": {"enum": ["NOT_RUN", "PASS", "FAIL", "BLOCKED"]},
        "result_path": {"type": "string", "minLength": 1, "maxLength": 500},
        "result_sha256": {"$ref": "#/$defs/sha256"},
        "evaluator_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "github_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "pull_request", "review_id", "reviewer_login", "reviewed_commit"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "pull_request": {"type": "integer", "minimum": 1},
        "review_id": {"type": "integer", "minimum": 1},
        "reviewer_login": {"type": "string", "minLength": 1, "maxLength": 100},
        "reviewed_commit": {"$ref": "#/$defs/sha1"}
      }
    }
  }
}
