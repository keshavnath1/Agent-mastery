{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Governed Parity Fixture Manifest",
  "type": "object",
  "required": [
    "module_id",
    "fixture_kind",
    "selection_version",
    "selection_policy",
    "selector",
    "record_count",
    "key_columns",
    "sources",
    "source_observations",
    "transformations",
    "coverage_assertions",
    "selection_reason_counts",
    "selected_key_hashes_sha256",
    "fixture_inputs",
    "oracle",
    "limitations"
  ],
  "properties": {
    "module_id": {"type": "string", "minLength": 1},
    "fixture_kind": {"type": "string", "minLength": 1},
    "selection_version": {"type": "string", "minLength": 1},
    "selection_policy": {"type": "string", "minLength": 1},
    "selector": {
      "type": "object",
      "required": ["path", "sha256", "command"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "record_count": {"type": "integer", "minimum": 1},
    "key_columns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "role"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "role": {"enum": ["input", "sas_reference", "sas_log", "sas_lst", "other"]}
        },
        "additionalProperties": false
      }
    },
    "source_observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "value", "evidence"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "value": {"type": ["string", "number", "integer", "boolean", "null"]},
          "evidence": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "transformations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description", "authority", "source_reference"],
        "properties": {
          "description": {"type": "string", "minLength": 1},
          "authority": {"type": "string", "minLength": 1},
          "source_reference": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "coverage_assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "mandatory", "status", "required", "observed"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "mandatory": {"type": "boolean"},
          "status": {"enum": ["PASS", "FAIL"]},
          "required": {},
          "observed": {}
        },
        "additionalProperties": false
      }
    },
    "selection_reason_counts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "integer", "minimum": 1}
    },
    "selected_key_hashes_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "fixture_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "oracle": {
      "type": "object",
      "required": ["path", "sha256", "columns", "created_from_sas_reference_only"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "columns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "created_from_sas_reference_only": {"const": true}
      },
      "additionalProperties": false
    },
    "privacy": {
      "type": "object",
      "properties": {
        "contains_raw_sensitive_rows": {"type": "boolean"},
        "distribution_allowed": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
