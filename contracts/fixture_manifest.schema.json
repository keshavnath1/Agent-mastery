{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Governed Parity Fixture Manifest",
  "type": "object",
  "required": [
    "module_id",
    "fixture_kind",
    "selection_policy",
    "record_count",
    "key_columns",
    "sources",
    "fixture_inputs",
    "oracle",
    "limitations"
  ],
  "properties": {
    "module_id": {"type": "string", "minLength": 1},
    "fixture_kind": {"type": "string", "minLength": 1},
    "selection_policy": {"type": "string", "minLength": 1},
    "record_count": {"type": "integer", "minimum": 1},
    "key_columns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "role"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "role": {"enum": ["input", "sas_reference", "sas_log", "sas_lst", "other"]}
        },
        "additionalProperties": false
      }
    },
    "fixture_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "oracle": {
      "type": "object",
      "required": ["path", "sha256", "columns", "created_from_sas_reference_only"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "columns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "created_from_sas_reference_only": {"const": true}
      },
      "additionalProperties": false
    },
    "privacy": {
      "type": "object",
      "properties": {
        "contains_raw_sensitive_rows": {"type": "boolean"},
        "distribution_allowed": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
